[Unit]
Description=Automatic Backup Notification Varlink Socket
PartOf=automatic-backup-notification.service

[Socket]
Service=automatic-backup-notification.service
ListenStream=/tmp/automatic-backup-%u/local.automatic-backup.Notification
FileDescriptorName=varlink
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
