{
	"name": "backup-devcontainer",
	"build": {
		"dockerfile": "Dockerfile",
		"options": ["--pull"],
		"args": {
			"USERNAME": "${env:USER}"
		},
		"context": ".."
	},
	"workspaceMount": "",
	"workspaceFolder": "/app",
	"remoteUser": "${env:UID}",
	"containerUser": "${env:UID}",
	"runArgs": [
		"--name", "backup-devcontainer-vscode",
		"--volume=${localWorkspaceFolder}:/app:rw,z",
		"-e", "USER=${env:USER}"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.pylint",
				"ms-python.python",
				"ms-python.flake8",
				"ms-python.black-formatter",
				"njpwerner.autodocstring"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	}
}
