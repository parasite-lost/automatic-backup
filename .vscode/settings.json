{
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        ".",
        "-p",
        "test*.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "python.testing.cwd": "${workspaceFolder}/src/automatic-backup",
    "pylint.args": ["--max-line-length=100"],
    "pylint.cwd": "${workspaceFolder}/src/automatic-backup",
    "flake8.args": ["--max-line-length=100"],
    "flake8.cwd": "${workspaceFolder}/src/automatic-backup",
    "black-formatter.args": ["--line-length=100"],
    "black-formatter.cwd": "${workspaceFolder}/src/automatic-backup",
    "python.useEnvironmentsExtension": false,
}
